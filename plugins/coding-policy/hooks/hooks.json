{
  "description": "Loads versioned workflow guidance. Does not execute git or change repository files.",
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact",
      "hooks": [{
        "type": "command",
        "command": "python3 \"${PLUGIN_ROOT}/scripts/session_start.py\"",
        "timeout": 5,
        "statusMessage": "Loading Cyberdyne coding policy",
        "additionalContextLimit": 1000
      }]
    }]
  }
}
